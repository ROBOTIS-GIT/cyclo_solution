  <version>0.1.0</version>
  <description>cuMotion planning, perception, and robot-model integration for CYCLO.</description>

  <maintainer email="pyo@robotis.com">Pyo</maintainer>
  <license>Apache 2.0</license>

  <author email="kyu@robotis.com">Yeonguk Kim</author>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <exec_depend>cyclo_cumotion_description</exec_depend>
  <exec_depend>cyclo_cumotion_moveit_config</exec_depend>
  <exec_depend>cyclo_cumotion_nvblox</exec_depend>
  <exec_depend>cyclo_cumotion_object_attachment</exec_depend>
  <exec_depend>cyclo_cumotion_robot_segmenter</exec_depend>
  <exec_depend>ament_index_python</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>moveit_configs_utils</exec_depend>
  <exec_depend>moveit_ros_move_group</exec_depend>
  <exec_depend>robotis_interfaces</exec_depend>
