ARG BASE_IMAGE=nvidia/cuda:13.2.0-devel-ubuntu24.04
FROM ${BASE_IMAGE}

SHELL ["/bin/bash", "-o", "pipefail", "-c"]

ARG DEBIAN_FRONTEND=noninteractive
ARG ROS_DISTRO=jazzy
ARG ISAAC_ROS_RELEASE=4.6
ARG ROBOTIS_INTERFACES_REPOSITORY=https://github.com/ROBOTIS-GIT/robotis_interfaces.git
ARG ROBOTIS_INTERFACES_BRANCH=feature-cumotion
ARG USE_PREBUILT_DEPENDENCIES=0

ENV ROS_DISTRO=${ROS_DISTRO} \
    COLCON_WS=/root/ros2_ws \
    LANG=en_US.UTF-8 \
    LC_ALL=en_US.UTF-8 \
    NVIDIA_VISIBLE_DEVICES=all \
    NVIDIA_DRIVER_CAPABILITIES=all

RUN if [ "${USE_PREBUILT_DEPENDENCIES}" != "1" ]; then \
      apt-get update \
      && apt-get install -y --no-install-recommends \
        build-essential ca-certificates cmake curl git gnupg locales nano vim \
        software-properties-common \
      && locale-gen en_US.UTF-8 \
      && add-apt-repository universe \
      && rm -rf /var/lib/apt/lists/*; \
    fi

# ROS 2 Jazzy and Isaac ROS 4.6 binary repositories.
RUN if [ "${USE_PREBUILT_DEPENDENCIES}" != "1" ]; then \
      curl -fsSL https://raw.githubusercontent.com/ros/rosdistro/master/ros.key \
        -o /usr/share/keyrings/ros-archive-keyring.gpg \
      && echo "deb [arch=$(dpkg --print-architecture) signed-by=/usr/share/keyrings/ros-archive-keyring.gpg] http://packages.ros.org/ros2/ubuntu noble main" \
        > /etc/apt/sources.list.d/ros2.list \
      && curl -fsSL https://isaac.download.nvidia.com/isaac-ros/repos.key \
        | gpg --dearmor --yes -o /usr/share/keyrings/nvidia-isaac-ros.gpg \
      && echo "deb [signed-by=/usr/share/keyrings/nvidia-isaac-ros.gpg] https://isaac.download.nvidia.com/isaac-ros/release-${ISAAC_ROS_RELEASE} noble main" \
        > /etc/apt/sources.list.d/nvidia-isaac-ros.list \
      && mkdir -p /etc/apt/keyrings \
      && curl -fsSL https://repo.download.nvidia.com/jetson/jetson-ota-public.asc \
        | gpg --dearmor --yes -o /etc/apt/keyrings/nvidia-jetson.gpg \
      && echo "deb [signed-by=/etc/apt/keyrings/nvidia-jetson.gpg] https://repo.download.nvidia.com/jetson/x86_64/noble r39.2 main" \
        > /etc/apt/sources.list.d/nvidia-jetson-apt-source.list; \
    fi

# Install only the binary packages needed for local MoveIt configurations to
# use cuMotion. The full isaac_ros_manipulation workflow is intentionally absent.
RUN mkdir -p /etc/isaac-ros-cli \
    && printf 'ISAAC_ROS_ENVIRONMENT=docker-activated\n' \
      > /etc/isaac-ros-cli/environment.conf

RUN if [ "${USE_PREBUILT_DEPENDENCIES}" != "1" ]; then \
      apt-mark unhold libcublas-13-2 libcublas-dev-13-2 2>/dev/null || true; \
    fi

# Keep this small attachment dependency delta outside the prebuilt-dependency
# guard so an older cached cuMotion image can still be reused safely.
RUN apt-get update \
    && apt-get install -y --no-install-recommends \
      ros-${ROS_DISTRO}-isaac-ros-cumotion-object-attachment \
      ros-${ROS_DISTRO}-std-srvs \
    && rm -rf /var/lib/apt/lists/*

RUN if [ "${USE_PREBUILT_DEPENDENCIES}" != "1" ]; then \
      apt-get update \
      && apt-get -o Dpkg::Options::="--force-confold" install -y --no-install-recommends \
        python3-colcon-common-extensions \
        python3-numpy \
        python3-opencv \
        python3-pip \
        python3-rosdep \
        python3-vcstool \
        ros-${ROS_DISTRO}-ament-cmake \
        ros-${ROS_DISTRO}-controller-manager \
        ros-${ROS_DISTRO}-cv-bridge \
        ros-${ROS_DISTRO}-isaac-ros-cumotion-robot-segmenter \
        ros-${ROS_DISTRO}-isaac-ros-cumotion-moveit \
        ros-${ROS_DISTRO}-isaac-ros-cumotion-object-attachment \
        ros-${ROS_DISTRO}-nvblox-ros \
        ros-${ROS_DISTRO}-joint-state-publisher \
        ros-${ROS_DISTRO}-joint-state-publisher-gui \
        ros-${ROS_DISTRO}-moveit-configs-utils \
        ros-${ROS_DISTRO}-moveit-kinematics \
        ros-${ROS_DISTRO}-moveit-ros-visualization \
        ros-${ROS_DISTRO}-moveit-simple-controller-manager \
        ros-${ROS_DISTRO}-realsense2-description \
        ros-${ROS_DISTRO}-robot-state-publisher \
        ros-${ROS_DISTRO}-ros-base \
        ros-${ROS_DISTRO}-rmw-zenoh-cpp \
        ros-${ROS_DISTRO}-rviz2 \
        ros-${ROS_DISTRO}-urdf \
        ros-${ROS_DISTRO}-vision-msgs \
        ros-${ROS_DISTRO}-warehouse-ros-sqlite \
        ros-${ROS_DISTRO}-xacro \
      && rm -rf /var/lib/apt/lists/*; \
    fi

RUN if [ "${USE_PREBUILT_DEPENDENCIES}" != "1" ]; then \
      rosdep init 2>/dev/null || true; \
    fi

WORKDIR ${COLCON_WS}
RUN rm -rf \
      ${COLCON_WS}/src/cyclo_solution \
      ${COLCON_WS}/src/robotis_interfaces \
      ${COLCON_WS}/build \
      ${COLCON_WS}/install \
      ${COLCON_WS}/log \
    && mkdir -p ${COLCON_WS}/src/cyclo_solution

RUN git clone --branch ${ROBOTIS_INTERFACES_BRANCH} --single-branch --depth 1 \
      ${ROBOTIS_INTERFACES_REPOSITORY} \
      ${COLCON_WS}/src/robotis_interfaces

# Match AI Worker's development layout. At runtime docker-compose bind-mounts
# the host repository over this path, while build/install remain in the workspace.
COPY . ${COLCON_WS}/src/cyclo_solution/

RUN source /opt/ros/${ROS_DISTRO}/setup.bash \
    && colcon build --symlink-install \
      --base-paths \
        ${COLCON_WS}/src/robotis_interfaces \
        ${COLCON_WS}/src/cyclo_solution \
      --cmake-args -DCMAKE_BUILD_TYPE=Release

RUN sed -i '/^# cyclo_solution development environment$/,$d' ~/.bashrc && \
    echo "source /opt/ros/${ROS_DISTRO}/setup.bash" >> ~/.bashrc && \
    echo "source ${COLCON_WS}/install/setup.bash" >> ~/.bashrc && \
    echo "alias cb='colcon build --symlink-install --cmake-args -DCMAKE_BUILD_TYPE=Release'" >> ~/.bashrc && \
    echo "alias zenohd='ros2 run rmw_zenoh_cpp rmw_zenohd'" >> ~/.bashrc && \
    echo "export RMW_IMPLEMENTATION=rmw_zenoh_cpp" >> ~/.bashrc && \
    echo "export ROS_DOMAIN_ID=30" >> ~/.bashrc

# Keep the development container alive through its allocated TTY.
CMD ["bash"]
