<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>cyclo_cumotion_robot_segmenter</name>
  <version>0.1.0</version>
  <description>Moving-camera robot segmentation for the CYCLO cuMotion module.</description>

  <maintainer email="pyo@robotis.com">Pyo</maintainer>
  <license>Apache 2.0</license>

  <url type="repository">https://github.com/ROBOTIS-GIT/cyclo_solution</url>

  <author>Karanbir Chahal</author>
  <author email="kyu@robotis.com">Yeonguk Kim</author>

  <buildtool_depend>ament_cmake_auto</buildtool_depend>
  <build_depend>isaac_ros_common</build_depend>

  <depend>ament_index_cpp</depend>
  <depend>eigen</depend>
  <depend>geometry_msgs</depend>
  <depend>isaac_ros_cumotion_interfaces</depend>
  <depend>isaac_ros_nitros</depend>
  <depend>isaac_ros_nitros_image_type</depend>
  <depend>rclcpp</depend>
  <depend>rclcpp_components</depend>
  <depend>sensor_msgs</depend>
  <depend>std_msgs</depend>
  <depend>tf2_eigen</depend>
  <depend>tf2_ros</depend>
  <depend>yaml-cpp</depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
